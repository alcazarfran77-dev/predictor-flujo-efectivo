{
 "openapi": "3.1.0",
 "info": {
  "title": "API del predictor de flujo de efectivo",
  "description": "Pronóstico diario de flujo de efectivo con cuantiles P10, P50 y P90, alerta de déficit y métricas de confianza del backtest walk-forward. Montos en pesos mexicanos (MXN).",
  "version": "1.1.0"
 },
 "paths": {
  "/api/v1/salud": {
   "get": {
    "summary": "Estado del servicio, datos cargados y modelos",
    "operationId": "salud_api_v1_salud_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Salud"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/series": {
   "get": {
    "summary": "Series diarias disponibles",
    "operationId": "series_api_v1_series_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/Serie"
         },
         "type": "array",
         "title": "Response Series Api V1 Series Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/series/{serie}/historia": {
   "get": {
    "summary": "Valores diarios observados",
    "operationId": "historia_api_v1_series__serie__historia_get",
    "parameters": [
     {
      "name": "serie",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Serie"
      }
     },
     {
      "name": "dias",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 400,
       "minimum": 5,
       "default": 60,
       "title": "Dias"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Historia"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/pronostico": {
   "get": {
    "summary": "P10, P50 y P90 por día, alerta de déficit y confianza de una serie",
    "operationId": "pronostico_api_v1_pronostico_get",
    "parameters": [
     {
      "name": "serie",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "OPERATIVO_TOTAL",
       "title": "Serie"
      }
     },
     {
      "name": "modelo",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Modelo"
      }
     },
     {
      "name": "horizonte",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 5,
       "minimum": 1,
       "default": 5,
       "title": "Horizonte"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Pronostico"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "post": {
    "summary": "Pronostica una serie enviada por otro sistema (sin métricas de backtest)",
    "operationId": "pronostico_externo_api_v1_pronostico_post",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/PeticionPronostico"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Pronostico"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/alertas": {
   "get": {
    "summary": "Alerta de déficit de todas las series",
    "operationId": "alertas_api_v1_alertas_get",
    "parameters": [
     {
      "name": "modelo",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Modelo"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/AlertaSerie"
         },
         "title": "Response Alertas Api V1 Alertas Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/metricas": {
   "get": {
    "summary": "Métricas de confianza, umbrales y monitoreo",
    "operationId": "metricas_api_v1_metricas_get",
    "parameters": [
     {
      "name": "modelo",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Modelo"
      }
     },
     {
      "name": "serie",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": "OPERATIVO_TOTAL",
       "title": "Serie"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Metricas"
        }
       }
      }
     },
     "503": {
      "description": "El backtest del modelo todavía se está calculando"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/modelos": {
   "get": {
    "summary": "Modelos lado a lado con los criterios de aceptación y de cambio de modelo",
    "operationId": "modelos_api_v1_modelos_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "items": {
          "$ref": "#/components/schemas/ComparacionModelo"
         },
         "type": "array",
         "title": "Response Modelos Api V1 Modelos Get"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/reporte": {
   "get": {
    "summary": "Pronóstico completo de un modelo (todas las series, alertas y confianza) en un solo JSON",
    "operationId": "reporte_api_v1_reporte_get",
    "parameters": [
     {
      "name": "modelo",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Modelo"
      }
     },
     {
      "name": "descargar",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "description": "true = responde como archivo para guardar",
       "default": false,
       "title": "Descargar"
      },
      "description": "true = responde como archivo para guardar"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Reporte"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "post": {
    "summary": "Escribe el reporte JSON en la carpeta de salidas del servidor",
    "operationId": "guardar_reporte_api_v1_reporte_post",
    "parameters": [
     {
      "name": "modelo",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Modelo"
      }
     }
    ],
    "responses": {
     "201": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ArchivoGenerado"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/datos/validar": {
   "post": {
    "summary": "Revisa un JSON de movimientos sin cargarlo: errores por movimiento y campo, y avisos",
    "operationId": "validar_datos_api_v1_datos_validar_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "title": "Contenido",
        "description": "Objeto con 'movimientos' o lista de movimientos"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
